DATABASE_URL=
DATABASE_URL_UNPOOLED=
SESSION_SECRET=
ADMIN_INITIAL_PASSWORD=admin123
NEXT_PUBLIC_APP_NAME=OSP Logbook

# Senha inicial dos novos analistas. Configure apenas no ambiente de produção.
ANALYST_INITIAL_PASSWORD=

# ETL OSP Alerta: SQL Server -> PostgreSQL/Neon
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=ProfessionalServices02
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DOMAIN=
SQLSERVER_INSTANCE=
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_CERT=true
SQLSERVER_CONNECTION_TIMEOUT_MS=15000
SQLSERVER_REQUEST_TIMEOUT_MS=120000

# Origem padrão: ProfessionalServices02.dbo.OSP_Alerta
OSP_ALERTA_SOURCE_TABLE=ProfessionalServices02.dbo.OSP_Alerta
OSP_ALERTA_BATCH_SIZE=500

# Segurança: false preserva os dados do PostgreSQL se a origem retornar zero linhas.
OSP_ALERTA_ALLOW_EMPTY_REPLACE=false
