# Copie para .env somente no Windows interno. NUNCA versionar credenciais.
# Instalação Python 3.13.15: caminho UNC configurado no INSTALAR_DEPENDENCIAS.bat
# SQL Server: usuário somente leitura; ou SQL_TRUSTED_CONNECTION=1
SQL_USER=
SQL_PASSWORD=
SQL_TRUSTED_CONNECTION=0
SQL_PORT=1433
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=no
SQL_TRUST_CERTIFICATE=yes
SQL_CONNECT_TIMEOUT=15
SQL_QUERY_TIMEOUT=240

# Neon/PostgreSQL: prefira URL unpooled, com permissão restrita às tabelas OSP Locator.
DATABASE_URL_UNPOOLED=
PG_SSLMODE=require

# Copie seu arquivo de servidores para servidores.json nesta mesma pasta.
# Pode informar um caminho absoluto para um JSON mantido fora do repositório.
LOCATOR_SERVERS_FILE=
