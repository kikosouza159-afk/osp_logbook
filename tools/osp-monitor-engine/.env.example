# OSP MONITOR ENGINE
NEON_DATABASE_URL=postgresql://usuario:senha@host/database?sslmode=require

# Os IPs dos servidores ficam em servers.py
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=ProfessionalServices02
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# sql ou trusted
SQLSERVER_AUTH=sql
SQLSERVER_USER=SEU_USUARIO
SQLSERVER_PASSWORD=SUA_SENHA

SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_CERT=true
SQLSERVER_CONNECTION_TIMEOUT=20
SQLSERVER_QUERY_TIMEOUT=180

TABULATION_SOURCE_TABLE=ProfessionalServices02.dbo.OSP_Alerta_Painel
PBX_SOURCE_TABLE=ProfessionalServices02.dbo.Osp_Alerta_Retorno_Painel

# false = preserva o Neon se qualquer servidor/fonte vier vazio
ALLOW_EMPTY_SOURCE=false

INSERT_BATCH_SIZE=1000
